generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // Exporte les imports relatifs avec l'extension ".ts" afin que le client
  // reste importable par Node (seed) en plus du bundler Next.
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}


model Photographer {
	id	Int	@id @default(autoincrement())
	name	String
	city	String
	country	String
	tagline	String
	price	Int
	portrait		String
    medias  Media[]
}

model Media {
	id	Int	@id @default(autoincrement())
	photographer	Photographer	@relation(fields: [photographerId], references: [id])
	photographerId	Int
	title	String
	image	String?
    video   String?
	likes	Int
	date	String
	price	Int
}